+class SampleFileHandle {
+    HANDLE h;
+public:
+    explicit SampleFileHandle(HANDLE value) : h(value) {}
+    ~SampleFileHandle() { if (h != INVALID_HANDLE_VALUE) CloseHandle(h); }
+    HANDLE Get() const { return h; }
+    SampleFileHandle(const SampleFileHandle&) = delete;
+    SampleFileHandle& operator=(const SampleFileHandle&) = delete;
+};
+inline D3D12_CPU_DESCRIPTOR_HANDLE SampleCPUHandle(ID3D12DescriptorHeap* h) {
+    D3D12_CPU_DESCRIPTOR_HANDLE value; h->GetCPUDescriptorHandleForHeapStart(&value); return value;
+}
+inline D3D12_GPU_DESCRIPTOR_HANDLE SampleGPUHandle(ID3D12DescriptorHeap* h) {
+    D3D12_GPU_DESCRIPTOR_HANDLE value; h->GetGPUDescriptorHandleForHeapStart(&value); return value;
+}
